#!/bin/zsh
# =============================================================================
# macOS .zshrc - Clean and optimized
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# System Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Fix Alacritty file watcher error
ulimit -n 8192

# Environment
export LANG=en_US.UTF-8

# Editor
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# ─────────────────────────────────────────────────────────────────────────────
# Oh My Zsh Configuration
# ─────────────────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Update settings
zstyle ':omz:update' mode reminder
zstyle ':omz:update' frequency 10

# Features
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

# Plugins - CRITICAL: Only use one plugins=() declaration!
plugins=(
  git
  zsh-syntax-highlighting
  zsh-autosuggestions
)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# ─────────────────────────────────────────────────────────────────────────────
# PATH Configuration (macOS specific)
# ─────────────────────────────────────────────────────────────────────────────
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH="/opt/homebrew/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Development tools
export PATH="/usr/local/go/bin:$PATH"
export GOPATH=$HOME/go
export PATH="$GOPATH/bin:$PATH"

# Node/npm
export PATH="./node_modules/.bin:$PATH"

# Rust
export PATH="$HOME/.cargo/bin:$PATH"

# Python framework (if you have it)
export PATH="/Library/Frameworks/Python.framework/Versions/3.12/bin:$PATH"

# ─────────────────────────────────────────────────────────────────────────────
# Completion System
# ─────────────────────────────────────────────────────────────────────────────
autoload -Uz compinit
compinit -d ~/.cache/zcompdump

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' rehash true
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose true

# ─────────────────────────────────────────────────────────────────────────────
# Shell Options
# ─────────────────────────────────────────────────────────────────────────────
setopt AUTO_CD              # Type directory name to cd
setopt HIST_IGNORE_DUPS     # Don't record duplicate commands
setopt SHARE_HISTORY        # Share history between sessions

# ─────────────────────────────────────────────────────────────────────────────
# Aliases - File Operations
# ─────────────────────────────────────────────────────────────────────────────
alias l='ls'
alias ll='ls -l'
alias lla='ls -la'
alias LLA='ls -la'
alias lsdir='ls -l | awk "{print \"\033[1;31m\"\$9\"\033[0m\"}"'
alias late='ls -lt | head -n 10'

# ─────────────────────────────────────────────────────────────────────────────
# Aliases - Text Editors
# ─────────────────────────────────────────────────────────────────────────────
alias v='nvim'
alias n='nvim'
alias nn='nvim .'
alias c='cat'
alias b='bat'  # macOS uses 'bat', not 'batcat'

# ─────────────────────────────────────────────────────────────────────────────
# Aliases - System Operations
# ─────────────────────────────────────────────────────────────────────────────
alias e='exit'
alias q='exit'
alias s='sudo su'
alias rr='ranger'
alias pa='pass add'
alias p='pass'

# macOS specific (different from Linux)
alias brewup='brew update && brew upgrade'
alias brewclean='brew cleanup'

# ─────────────────────────────────────────────────────────────────────────────
# Aliases - Navigation
# ─────────────────────────────────────────────────────────────────────────────
alias down='cd ~/Downloads'
alias doc='cd ~/Documents'
alias proj='cd ~/Projects'
alias pic='cd ~/Pictures'
alias mus='cd ~/Music'
alias vid='cd ~/Movies'
alias bots='cd ~/Projects/Bots'
alias ff='fastfetch'

alias pythonproj='cd ~/Projects/Python'
alias linuxthings='cd ~/Projects/LinuxThings'
alias paladdin='cd ~/Projects/Bots/Crypto/CryptoAnalysisBot'
# ─────────────────────────────────────────────────────────────────────────────
# Aliases - Config Files
# ─────────────────────────────────────────────────────────────────────────────
alias rc='nvim ~/.zshrc'
alias vrc='nvim ~/.zshrc'
alias vv='nvim ~/.vimrc'
alias bb='bat ~/.zshrc'
alias nvconf='cd ~/.config/nvim'
alias alconf='nvim ~/.config/alacritty/alacritty.toml'
alias ohmyzsh='cd ~/.oh-my-zsh'

# ─────────────────────────────────────────────────────────────────────────────
# Aliases - Media
# ─────────────────────────────────────────────────────────────────────────────
alias yt='yt-dlp'
alias yta='yt-dlp -x --audio-format mp3'
#alias yt='yt-dlp'
#alias yta='yt-dlp -x --audio-format mp3'

# ─────────────────────────────────────────────────────────────────────────────
# Aliases - Networking (macOS specific)
# ─────────────────────────────────────────────────────────────────────────────
alias png='ping 1.1.1.1'
alias myip='curl ifconfig.me'
alias localip='ipconfig getifaddr en0'

# ─────────────────────────────────────────────────────────────────────────────
# Optional: NVM (Node Version Manager)
# ─────────────────────────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use 2>/dev/null
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" 2>/dev/null

# ─────────────────────────────────────────────────────────────────────────────
# Optional: FZF (Fuzzy Finder)
# ─────────────────────────────────────────────────────────────────────────────
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Pyenv
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment if you use pyenv:
# export PYENV_ROOT="$HOME/.pyenv"
# export PATH="$PYENV_ROOT/bin:$PATH"
# eval "$(pyenv init --path)"
# eval "$(pyenv init -)"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Fastfetch on startup
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment to show system info on terminal launch:
# fastfetch

# End of .zshrc
alias git='nocorrect git'
alias git='nocorrect git'
alias deploy='git pull && pkill -f server.py; sleep 1 && nohup ./venv/bin/python3 server.py &'

